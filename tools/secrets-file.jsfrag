var schSecretsFile = (() => {
  // 所有密钥与服务地址集中在 Vault 之外的一个文件里，用户可直接打开编辑；
  // data.json 里对应字段一律清空。插件读写设置时自动与这个文件对应。
  const fs = require("node:fs"), path = require("node:path"), os = require("node:os");
  // [文件里的位置, 插件设置里的字段]；rssBoard.* 指文献订阅面板的数据。
  const FIELDS = [
    ["assistant.apiKey", "aiApiKey"],
    ["assistant.endpoint", "aiCustomEndpoint"],
    ["writing.apiKey", "writingApiKey"],
    ["writing.endpoint", "writingCustomEndpoint"],
    ["literatureSummary.apiKey", "rssAiApiKey"],
    ["literatureSummary.endpoint", "rssAiCustomEndpoint"],
    ["openalex.apiKey", "openalexApiKey"],
    ["openalex.email", "openalexEmail"],
    ["mineru.apiKey", "mineruApiKey"],
    ["mineru.mode", "mineruOcrMode"],
    ["cloudSync.webdavUrl", "cloudWebdavUrl"],
    ["cloudSync.webdavUser", "cloudWebdavUser"],
    ["cloudSync.webdavPassword", "cloudWebdavPass"],
    ["cloudSync.s3Endpoint", "cloudS3Endpoint"],
    ["cloudSync.s3Bucket", "cloudS3Bucket"],
    ["cloudSync.s3Region", "cloudS3Region"],
    ["cloudSync.s3AccessKey", "cloudS3AccessKey"],
    ["cloudSync.s3SecretKey", "cloudS3SecretKey"],
    ["unpaywall.email", "rssBoard.unpaywallEmail"],
  ];
  const NOTE = "Scholarium 的全部密钥与服务地址。直接编辑本文件后保存，插件会自动读取（约 2 秒内生效）；在插件设置里修改也会写回这里。本文件不在 Vault 中，不会被同步或提交。";
  const DEFAULT_PATH = path.join(os.homedir(), "Scholarium", "scholarium-secrets.json");
  let selectedPath = "";
  let watchedPath = "";
  const normalizePath = (value) => value ? path.resolve(String(value)) : "";
  const filePath = () => selectedPath || process.env.SCHOLARIUM_SECRETS_FILE || DEFAULT_PATH;
  const getIn = (obj, dotted) => dotted.split(".").reduce((o, k) => (o && typeof o === "object" ? o[k] : undefined), obj);
  const setIn = (obj, dotted, value) => {
    const keys = dotted.split(".");
    let o = obj;
    for (const k of keys.slice(0, -1)) { if (!o[k] || typeof o[k] !== "object") o[k] = {}; o = o[k]; }
    o[keys[keys.length - 1]] = value;
  };
  const read = (target = filePath()) => {
    try { return JSON.parse(fs.readFileSync(target, "utf8")); } catch (_) { return null; }
  };
  const write = (file, target = filePath()) => {
    fs.mkdirSync(path.dirname(target), { recursive: true });
    const tmp = target + ".tmp";
    fs.writeFileSync(tmp, JSON.stringify(file, null, 2) + "\n", { encoding: "utf8", mode: 0o600 });
    try { fs.renameSync(tmp, target); } catch (_) { fs.copyFileSync(tmp, target); fs.rmSync(tmp, { force: true }); }
  };
  const fromData = (data) => {
    const file = { "_说明": NOTE };
    for (const [where, field] of FIELDS) {
      const value = getIn(data, field);
      setIn(file, where, value === undefined || value === null ? "" : value);
    }
    if (!getIn(file, "mineru.mode")) setIn(file, "mineru.mode", "scanned");
    return file;
  };
  const overlay = (data, file, { settingsOnly = false } = {}) => {
    for (const [where, field] of FIELDS) {
      const value = getIn(file, where);
      if (value === undefined) continue;
      if (field.startsWith("rssBoard.")) {
        // 面板数据只在已存在时覆盖，不凭空造出 rssBoard 对象。
        if (settingsOnly || !data.rssBoard || typeof data.rssBoard !== "object") continue;
      }
      setIn(data, field, value);
    }
    return data;
  };
  const strip = (data) => {
    const copy = JSON.parse(JSON.stringify(data || {}));
    for (const [, field] of FIELDS) if (getIn(copy, field) !== undefined) setIn(copy, field, "");
    return copy;
  };
  const same = (a, b) => FIELDS.every(([where]) => String(getIn(a, where) ?? "") === String(getIn(b, where) ?? ""));

  function install(plugin) {
    if (plugin.__schSecretsInstalled) return;
    plugin.__schSecretsInstalled = true;
    const origLoad = plugin.loadData.bind(plugin), origSave = plugin.saveData.bind(plugin);
    plugin.loadData = async () => {
      const raw = (await origLoad()) || {};
      const configured = plugin.__schSecretsPendingPath ?? plugin.settings?.secretsFilePath ?? raw.secretsFilePath;
      if (configured !== undefined) selectedPath = normalizePath(configured);
      let file = read();
      if (!file) {
        // 第一次：把 data.json 里现有的密钥/地址迁出来，然后清空 data.json 中的副本。
        file = fromData(raw);
        try {
          // 旧版单独存放的 MinerU 配置并入统一文件。
          const legacy = JSON.parse(fs.readFileSync(path.join(process.env.APPDATA || path.join(os.homedir(), ".config"), "Scholarium", "secrets", "mineru.json"), "utf8"));
          if (legacy.token && !getIn(file, "mineru.apiKey")) setIn(file, "mineru.apiKey", legacy.token);
          if (legacy.mode) setIn(file, "mineru.mode", legacy.mode);
        } catch (_) { /* none */ }
        write(file);
        await origSave(strip(raw));
      }
      // 兼容旧版 Vault 内的 OpenAlex 密钥文件；复制到统一文件但保留旧文件。
      try {
        const vaultRoot = plugin.app && plugin.app.vault && plugin.app.vault.adapter && plugin.app.vault.adapter.getBasePath && plugin.app.vault.adapter.getBasePath();
        const legacyPath = vaultRoot && path.join(vaultRoot, "Scholarium", "secrets", "openalex-api-key.txt");
        const legacy = legacyPath && fs.readFileSync(legacyPath, "utf8").trim().replace(/^\uFEFF/, "");
        if (legacy && !String(getIn(file, "openalex.apiKey") || "").trim()) {
          setIn(file, "openalex.apiKey", legacy);
          write(file);
        }
      } catch (_) { /* no legacy OpenAlex file */ }
      return overlay(raw, file);
    };
    plugin.saveData = async (data) => {
      if (data && Object.prototype.hasOwnProperty.call(data, "secretsFilePath")) selectedPath = normalizePath(data.secretsFilePath);
      const next = fromData(data);
      const current = read();
      if (!current || !same(current, next)) write({ ...(current || {}), ...next, "_说明": NOTE });
      return origSave(strip(data));
    };
    // 用户直接改文件：轮询修改时间，载入到当前设置（不重启）。
    const refreshWatch = () => {
      const target = filePath();
      if (watchedPath === target) return;
      if (watchedPath) fs.unwatchFile(watchedPath);
      watchedPath = target;
      try { fs.watchFile(target, { interval: 2000 }, (cur, prev) => {
        if (cur.mtimeMs === prev.mtimeMs) return;
        const file = read();
        if (!file || !plugin.settings) return;
        overlay(plugin.settings, file, { settingsOnly: true });
        const board = window.__scholariumDashboardView && window.__scholariumDashboardView.rssBoard;
        if (board && board.data) board.data.unpaywallEmail = getIn(file, "unpaywall.email") || "";
        try { plugin.initCloudSync && plugin.initCloudSync(); } catch (_) {}
        try { plugin.refreshDashboards && plugin.refreshDashboards(); } catch (_) {}
      }); } catch (_) { /* watching is a convenience */ }
    };
    refreshWatch();
    plugin.register(() => { if (watchedPath) fs.unwatchFile(watchedPath); });
    plugin.addCommand({ id: "open-secrets-file", name: "打开密钥与地址文件", callback: () => openFile() });
  }
  function ensureExists() {
    if (!fs.existsSync(filePath())) write(fromData({}));
  }
  function openFile() {
    ensureExists();
    try { require("electron").shell.openPath(filePath()); } catch (error) { new (require("obsidian").Notice)("无法打开：" + filePath()); }
  }
  function showInFolder() {
    ensureExists();
    try { require("electron").shell.showItemInFolder(filePath()); } catch (_) { new (require("obsidian").Notice)(filePath()); }
  }
  async function setLocation(plugin, folder) {
    const requested = folder ? path.join(path.resolve(folder), "scholarium-secrets.json") : "";
    const target = requested || process.env.SCHOLARIUM_SECRETS_FILE || DEFAULT_PATH;
    const current = read(filePath());
    const existing = read(target);
    if (existing && plugin.settings) overlay(plugin.settings, existing, { settingsOnly: true });
    else if (current && normalizePath(target) !== normalizePath(filePath()) && !fs.existsSync(target)) write(current, target);
    selectedPath = normalizePath(requested);
    plugin.__schSecretsPendingPath = target;
    plugin.settings.secretsFilePath = requested;
    await plugin.saveSettings();
    delete plugin.__schSecretsPendingPath;
    selectedPath = normalizePath(requested);
    return filePath();
  }
  function chooseLocation(plugin) {
    try {
      const electron = require("electron");
      const dialog = electron.dialog || (electron.remote && electron.remote.dialog);
      if (!dialog || !dialog.showOpenDialogSync) throw new Error("系统目录选择器不可用");
      const selected = dialog.showOpenDialogSync({ title: "选择 Scholarium 密钥文件保存位置", properties: ["openDirectory", "createDirectory"] });
      return selected && selected[0] ? setLocation(plugin, selected[0]) : null;
    } catch (error) {
      new (require("obsidian").Notice)("无法选择保存位置：" + error.message);
      return null;
    }
  }
  async function resetLocation(plugin) { return setLocation(plugin, ""); }
  function renderSettingsBox(container, plugin) {
    const box = container.createDiv({ cls: "sch-secrets-file-box" });
    box.setCssStyles({ border: "1px solid var(--background-modifier-border)", borderRadius: "8px", padding: "10px 12px", margin: "0 0 14px" });
    box.createEl("div", { text: "密钥与服务地址文件" }).setCssStyles({ fontWeight: "600", marginBottom: "4px" });
    box.createEl("div", { text: "所有 API Key、服务地址、云同步账号都只保存在这个文件里（不在 Vault 中），可以直接打开编辑；下方设置里的对应项会同步写回该文件。" }).setCssStyles({ color: "var(--text-muted)", fontSize: "12px" });
    const pathLine = box.createEl("code", { text: filePath() });
    pathLine.setCssStyles({ display: "block", margin: "6px 0", userSelect: "all", wordBreak: "break-all" });
    const row = box.createDiv();
    row.setCssStyles({ display: "flex", gap: "8px" });
    row.createEl("button", { text: "打开文件", cls: "mod-cta" }).onclick = () => openFile();
    row.createEl("button", { text: "在文件夹中显示" }).onclick = () => showInFolder();
    row.createEl("button", { text: "选择保存位置" }).onclick = async () => {
      const selected = await chooseLocation(plugin);
      if (selected) pathLine.setText(selected);
    };
    row.createEl("button", { text: "恢复默认位置" }).onclick = async () => {
      const selected = await resetLocation(plugin);
      pathLine.setText(selected);
    };
  }
  return { install, renderSettingsBox, openFile, showInFolder, filePath, FIELDS, fromData, overlay, strip };
})();
