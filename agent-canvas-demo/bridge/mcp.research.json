{
  "mcpServers": {
    "scansci-pdf": {
      "type": "stdio",
      "command": "scansci-pdf",
      "args": [
        "run"
      ],
      "env": {}
    },
    "scholarium": {
      "type": "stdio",
      "command": "node",
      "args": [
        "-e",
        "require(process.env.SCHOLARIUM_MCP_SERVER_PATH)"
      ],
      "env": {}
    }
  }
}
